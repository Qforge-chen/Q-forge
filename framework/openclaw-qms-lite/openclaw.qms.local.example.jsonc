{
  // Public example profile for a local QMS Lite OpenClaw runtime.
  // Real tokens, local IPs, and private paths are intentionally omitted.

  agents: {
    defaults: {
      model: {
        primary: "lmstudio/qwen3.5-27b-claude-4.6-opus-reasoning-distilled",
      },
    },
    list: [
      {
        id: "qm-intake",
        default: true,
        name: "QMS Intake",
        workspace: "__WORKSPACE_ROOT__/workspaces/qm-intake",
        tools: {
          allow: ["read", "qm_case_get", "qm_spec_clause_get", "sessions_spawn"],
          deny: ["exec", "write", "edit", "apply_patch", "browser", "cron", "gateway"],
        },
      },
      {
        id: "qm-review",
        name: "QMS Review",
        workspace: "__WORKSPACE_ROOT__/workspaces/qm-review",
        tools: {
          allow: [
            "read",
            "qm_8d_audit_artifact",
            "qm_8d_review_strict",
            "qm_report_parse",
            "qm_report_compare",
            "qm_claim_evidence_check",
            "qm_supplier_analyze",
            "qm_supplier_report_check",
            "qm_report_render",
            "qm_spec_clause_get",
          ],
          deny: ["exec", "write", "edit", "apply_patch", "browser", "cron", "gateway"],
        },
      },
      {
        id: "qm-rca",
        name: "QMS RCA",
        workspace: "__WORKSPACE_ROOT__/workspaces/qm-rca",
        tools: {
          allow: [
            "read",
            "qm_case_get",
            "qm_spec_clause_get",
            "qm_rca_detective_bootstrap",
            "qm_rca_detective_strict",
            "qm_rca_detective_artifact",
            "qm_evidence_matrix",
            "qm_report_render",
          ],
          deny: ["exec", "write", "edit", "apply_patch", "browser", "cron", "gateway"],
        },
      },
    ],
  },

  models: {
    mode: "merge",
    providers: {
      lmstudio: {
        baseUrl: "http://127.0.0.1:1234/v1",
        api: "openai-responses",
        apiKey: "lmstudio-local",
        models: [
          {
            id: "qwen3.5-27b-claude-4.6-opus-reasoning-distilled",
            name: "Local QMS Model",
            contextWindow: 90000,
            maxTokens: 8192,
            input: ["text"],
          },
        ],
      },
    },
  },

  gateway: {
    mode: "local",
    port: 18789,
    bind: "lan",
    auth: {
      mode: "token",
      token: "__GATEWAY_TOKEN__",
    },
    tls: {
      enabled: true,
      autoGenerate: true,
    },
  },
}
